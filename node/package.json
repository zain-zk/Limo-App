    "jsonwebtoken": "^9.0.2",
    "resend": "^6.17.2",
    "stripe": "^22.3.1",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  }
