DATABASE_URL="postgresql://limo:limo_dev_password@localhost:5432/limo_app?schema=public"
PORT=3001
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Public site URL (used for Stripe success/cancel redirects)
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed origins for CORS (production: https://high5limo.ca)
CORS_ORIGIN=http://localhost:5173

# Stripe (Checkout after quote)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad

# SMS (Twilio) — owner alerts on new booking. Do not commit real secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADMIN_PHONE=

# WhatsApp admin alerts (Twilio). Independent of the SMS settings above.
# Reuses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN when those are set.
# If the sender or destination below is missing, the API logs the message
# and the booking still succeeds. Do not commit real secrets or join codes.
#
# Sandbox: Twilio Console → Messaging → Try it out → Send a WhatsApp message.
# From the admin phone, WhatsApp the join phrase shown there (it looks like
# "join <two-words>") to the sandbox number, usually +1 415 523 8886.
# Set TWILIO_WHATSAPP_NUMBER to that sender (e.g. +14155238886) and leave
# TWILIO_WHATSAPP_CONTENT_SID empty so new bookings send a free-form body.
#
# Production: business-initiated WhatsApp outside the 24-hour customer-care
# window must use a pre-approved template. Create a Twilio Content template
# whose variables are exactly:
#   {{1}} customer name   {{2}} email   {{3}} phone   {{4}} preferred contact
#   {{5}} service   {{6}} vehicle   {{7}} date   {{8}} time
#   {{9}} passengers   {{10}} bags   {{11}} pickup   {{12}} drop-off
#   {{13}} flight number (N/A when empty)
# End the template with static text. Set TWILIO_WHATSAPP_CONTENT_SID to its
# HX... SID and TWILIO_WHATSAPP_NUMBER to your WhatsApp-enabled sender.
#
# ADMIN_WHATSAPP is the destination in E.164 (country code included). A 10-digit
# North American number is accepted and prefixed with +1. If ADMIN_WHATSAPP is
# unset, ADMIN_PHONE is used when it looks like a usable number. SMS still sends
# whenever the SMS settings above are present.
TWILIO_WHATSAPP_NUMBER=
ADMIN_WHATSAPP=
TWILIO_WHATSAPP_CONTENT_SID=

# Email (Resend) — customer acknowledgments, quotes, payment confirmations
RESEND_API_KEY=
EMAIL_FROM="High5 Limo <bookings@high5limo.ca>"

# Spam protection (Cloudflare Turnstile) — optional in dev
TURNSTILE_SECRET_KEY=
