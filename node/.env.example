DATABASE_URL="postgresql://limo:limo_dev_password@localhost:5432/limo_app?schema=public"
PORT=3001
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Public site URL (used for Stripe success/cancel redirects)
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed origins for CORS (production: https://high5limo.ca)
CORS_ORIGIN=http://localhost:5173

# Stripe (Checkout after quote)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad

# SMS (Twilio) — owner alerts on new booking
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADMIN_PHONE=

# Email (Resend) — customer acknowledgments, quotes, payment confirmations
RESEND_API_KEY=
EMAIL_FROM="High5 Limo <bookings@high5limo.ca>"

# Spam protection (Cloudflare Turnstile) — optional in dev
TURNSTILE_SECRET_KEY=
